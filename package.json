{
  "name": "alive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/frontend",
    "build": "npm run build -w apps/frontend",
    "typecheck": "npm run typecheck -w apps/frontend",
    "test:domain": "npm run test:domain -w apps/frontend",
    "test:e2e": "npm --workspace apps/frontend run test:e2e --",
    "test:e2e:ui": "npm --workspace apps/frontend run test:e2e:ui --",
    "preview": "npm run preview -w apps/frontend",
    "app:sync": "npm run build -w apps/frontend && cap sync",
    "app:open:ios": "cap open ios",
    "app:open:android": "cap open android"
  }
}
