{
  "name": "alive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/frontend -- --host 0.0.0.0",
    "build": "npm run build -w apps/frontend",
    "typecheck": "npm run typecheck -w apps/frontend",
    "test:domain": "npm run test:domain -w apps/frontend",
    "test:e2e": "npm --workspace apps/frontend run test:e2e --",
    "test:e2e:ui": "npm --workspace apps/frontend run test:e2e:ui --",
    "preview": "npm run preview -w apps/frontend",
    "backend:dev": "make backend-dev",
    "web:dev": "make web-dev",
    "web:build": "make web-build",
    "web:preview": "make web-preview",
    "cap:doctor": "make cap-doctor",
    "cap:build": "make cap-build",
    "cap:sync": "make cap-sync",
    "cap:open:ios": "make cap-open-ios",
    "cap:open:android": "make cap-open-android",
    "cap:run:ios": "make cap-run-ios",
    "cap:run:android": "make cap-run-android",
    "cap:checklist": "make cap-checklist",
    "app:sync": "make cap-sync",
    "app:open:ios": "make cap-open-ios",
    "app:open:android": "make cap-open-android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4"
  }
}
