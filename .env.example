# Copy this file to .env for local backend development.
# Do not commit .env. Production variables should be set in the deployment environment.

# MonoGPT Gemini API (server-only)
MONOGPT_GEMINI_API_KEY=
MONOGPT_GEMINI_BASE_URL=https://monogpt.kr/api/monorouter/v1/gemini
MONOGPT_GEMINI_MODEL_FAST=gemini-3.6-flash
MONOGPT_GEMINI_MODEL_GOOD=gemini-3.1-pro-preview
MONOGPT_GEMINI_FAST_INPUT_RATE_USD=1.5
MONOGPT_GEMINI_FAST_OUTPUT_RATE_USD=7.5
MONOGPT_GEMINI_GOOD_INPUT_RATE_USD=2.0
MONOGPT_GEMINI_GOOD_OUTPUT_RATE_USD=12.0
MONOGPT_GEMINI_TIMEOUT_MS=60000
API_DAILY_LIMIT=50
API_PAID_DAILY_LIMIT=200
API_MONTHLY_COST_LIMIT_USD=50
API_ESTIMATED_CALL_COST_USD=0.003

# Autonomous feed scheduler (keep disabled for local tests)
AUTO_POST_SCHEDULER_ENABLED=false
AUTO_POST_POLL_SECONDS=30
AUTO_POST_BATCH_SIZE=10
AUTO_POST_DEFAULT_INTERVAL_SECONDS=21600

# FastAPI backend
DATABASE_URL=postgresql+asyncpg://instarchat:instarchat@localhost:7555/instarchat
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_REDIRECT_URL=http://localhost:5173
VITE_LEGAL_BASE_URL=https://alive.imagebgremover.net
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=alive
S3_PRESIGN_EXPIRES_SECONDS=600
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=40000000
AUTH_SECRET_KEY=replace_with_a_long_random_string
AUTH_SESSION_TTL_SECONDS=604800
API_DOCS_ENABLED=false
TERMS_VERSION=2026-07-24
MODERATION_API_KEY=replace_with_a_long_random_moderation_secret
MODERATION_ACTOR=operations
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
NATIVE_OAUTH_REDIRECT_URL=com.ashwoodfriends.alive://oauth/callback
NATIVE_OAUTH_CODE_TTL_SECONDS=120

# Google ID login
GOOGLE_CLIENT_ID=google_oauth_client_id
GOOGLE_CLIENT_SECRET=google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Apple ID login
APPLE_CLIENT_ID=apple_service_id
APPLE_CLIENT_SECRET=apple_client_secret_jwt
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/apple/callback
APPLE_NATIVE_CLIENT_ID=com.ashwoodfriends.alive
APPLE_NATIVE_CLIENT_SECRET=apple_native_client_secret_jwt
APPLE_TEAM_ID=apple_developer_team_id
APPLE_KEY_ID=sign_in_with_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_p8_key\n-----END PRIVATE KEY-----"
OAUTH_TOKEN_ENCRYPTION_KEY=generate_a_fernet_key
APPLE_NOTIFICATION_AUDIENCES=apple_service_id,com.ashwoodfriends.alive

# Apps in Toss login (store certificate and key only in the deployment secret store)
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_APP_NAME=ashwoodfriends-alive
TOSS_MTLS_SECRETS_DIR=./secrets/toss
TOSS_MTLS_CERT_PATH=/run/secrets/toss/toss-mtls-cert.pem
TOSS_MTLS_KEY_PATH=/run/secrets/toss/toss-mtls-key.pem
TOSS_IAP_ENABLED=false
TOSS_IAP_PURCHASE_ENABLED=false
# 0 keeps new purchases closed; raise gradually to 100 after sandbox approval.
TOSS_IAP_PURCHASE_ROLLOUT_PERCENT=0
# Console product IDs are catalog identifiers, not secrets.
TOSS_IAP_CREDIT_5000_SKU=ait.0000058377.f2966bb1.6eb92fa59d.6425847961
TOSS_IAP_CREDIT_10000_SKU=ait.0000058377.9fbcbbf7.59cb266761.6425919018
TOSS_IAP_CREDIT_30000_SKU=ait.0000058377.f4432be6.c84ad9f6e6.6425951838
TOSS_IAP_CREDIT_50000_SKU=ait.0000058377.0d512108.d6b6db0cd2.6425984642
TOSS_IAP_CREDIT_100000_SKU=ait.0000058377.d51a71a8.20549ee68e.6426015918
# Stable server-only key; keep unchanged across auth/session key rotations.
TOSS_IAP_SUBJECT_HMAC_KEY=
# Sandbox grants require an explicit test-account allowlist and one configured product.
TOSS_IAP_SANDBOX_ENABLED=false
TOSS_IAP_SANDBOX_SUBJECT_HASHES=
TOSS_IAP_SANDBOX_PRODUCT_SKU=
TOSS_IAP_RECONCILIATION_ENABLED=false
# Emits an iap_integrity_alert error log when the reconciliation audit finds drift.
TOSS_IAP_AUDIT_ALERTS_ENABLED=false
TOSS_IAP_RECONCILIATION_POLL_SECONDS=3600
TOSS_IAP_RECONCILIATION_BATCH_SIZE=50

# Google Play one-time consumable credits (keep disabled until the internal test verifies server ownership).
GOOGLE_PLAY_IAP_ENABLED=false
GOOGLE_PLAY_IAP_PURCHASE_ENABLED=false
GOOGLE_PLAY_IAP_PURCHASE_ROLLOUT_PERCENT=0
GOOGLE_PLAY_IAP_PACKAGE_NAME=com.ashwoodfriends.alive
# Mount the Google Play Developer API service-account JSON only in the server secret store.
GOOGLE_PLAY_IAP_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google-play/service-account.json
GOOGLE_PLAY_SECRETS_DIR=./secrets/google-play
# Stable server-only key; keep unchanged across auth/session key rotations.
GOOGLE_PLAY_IAP_SUBJECT_HMAC_KEY=
GOOGLE_PLAY_RTDN_ENABLED=false
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_IAP_CREDIT_5000_PRODUCT_ID=alive.credits.500
GOOGLE_PLAY_IAP_CREDIT_10000_PRODUCT_ID=alive.credits.1000
GOOGLE_PLAY_IAP_CREDIT_30000_PRODUCT_ID=alive.credits.3150
GOOGLE_PLAY_IAP_CREDIT_50000_PRODUCT_ID=alive.credits.5500
GOOGLE_PLAY_IAP_CREDIT_100000_PRODUCT_ID=alive.credits.11500

# Apple App Store one-time consumable credits. Keep disabled until App Store Sandbox verifies server ownership.
APP_STORE_IAP_ENABLED=false
APP_STORE_IAP_PURCHASE_ENABLED=false
APP_STORE_IAP_PURCHASE_ROLLOUT_PERCENT=0
APP_STORE_IAP_BUNDLE_ID=com.ashwoodfriends.alive
# Numeric Apple ID from App Store Connect. Required before enabling the server in production.
APP_STORE_IAP_APP_APPLE_ID=0
# Read-only server mount containing Apple Root CA certificates.
APP_STORE_SECRETS_DIR=./secrets/app-store
# Comma-separated Apple Root CA certificate paths mounted only in the server secret store.
APP_STORE_IAP_ROOT_CERTIFICATE_PATHS=
APP_STORE_IAP_ONLINE_CHECKS_ENABLED=true
# Stable server-only key; keep unchanged across auth/session key rotations.
APP_STORE_IAP_SUBJECT_HMAC_KEY=
APP_STORE_IAP_CREDIT_5000_PRODUCT_ID=ALIVE_CREDITS_500
APP_STORE_IAP_CREDIT_10000_PRODUCT_ID=ALIVE_CREDITS_1000
APP_STORE_IAP_CREDIT_30000_PRODUCT_ID=ALIVE_CREDITS_3150
APP_STORE_IAP_CREDIT_50000_PRODUCT_ID=ALIVE_CREDITS_5500
APP_STORE_IAP_CREDIT_100000_PRODUCT_ID=ALIVE_CREDITS_11500
