# Copy this file to .env for local backend development.
# Do not commit .env. Production variables should be set in the deployment environment.

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_GOOD=gemini-2.5-pro
GEMINI_TIMEOUT_MS=45000
API_DAILY_LIMIT=50
API_MONTHLY_COST_LIMIT_USD=60
API_ESTIMATED_CALL_COST_USD=0.003

# Autonomous feed scheduler (keep disabled for local tests)
AUTO_POST_SCHEDULER_ENABLED=false
AUTO_POST_POLL_SECONDS=30
AUTO_POST_BATCH_SIZE=10
AUTO_POST_DEFAULT_INTERVAL_SECONDS=900

# FastAPI backend
DATABASE_URL=postgresql+asyncpg://instarchat:instarchat@localhost:7555/instarchat
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_REDIRECT_URL=http://localhost:5173
VITE_LEGAL_BASE_URL=https://alive.imagebgremover.net
AUTH_SECRET_KEY=replace_with_a_long_random_string
TERMS_VERSION=2026-07-24
MODERATION_API_KEY=replace_with_a_long_random_moderation_secret
MODERATION_ACTOR=operations
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
NATIVE_OAUTH_REDIRECT_URL=com.ashwoodfriends.alive://oauth/callback
NATIVE_OAUTH_CODE_TTL_SECONDS=120

# Google ID login
GOOGLE_CLIENT_ID=google_oauth_client_id
GOOGLE_CLIENT_SECRET=google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Apple ID login
APPLE_CLIENT_ID=apple_service_id
APPLE_CLIENT_SECRET=apple_client_secret_jwt
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/apple/callback
APPLE_NATIVE_CLIENT_ID=com.ashwoodfriends.alive
APPLE_NATIVE_CLIENT_SECRET=apple_native_client_secret_jwt
APPLE_TEAM_ID=apple_developer_team_id
APPLE_KEY_ID=sign_in_with_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_p8_key\n-----END PRIVATE KEY-----"
OAUTH_TOKEN_ENCRYPTION_KEY=generate_a_fernet_key
APPLE_NOTIFICATION_AUDIENCES=apple_service_id,com.ashwoodfriends.alive

# Apps in Toss login (store certificate and key only in the deployment secret store)
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_APP_NAME=ashwoodfriends-alive
TOSS_MTLS_SECRETS_DIR=./secrets/toss
TOSS_MTLS_CERT_PATH=/run/secrets/toss/toss-mtls-cert.pem
TOSS_MTLS_KEY_PATH=/run/secrets/toss/toss-mtls-key.pem

# AppStore/PlayStore Deployment
TERMS_VERSION=
MODERATION_API_KEY=
MODERATION_ACTOR=
