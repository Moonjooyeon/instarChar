{
  "name": "@alive/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:toss": "VITE_ALIVE_RUNTIME=apps-in-toss ait build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:domain": "tsc -p tsconfig.domain-tests.json && node --test .tmp/domain-tests/tests/domain/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.10.8",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
